# Supabase project settings > API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend
RESEND_API_KEY=your-resend-api-key
# Must be an address on a domain you've verified in Resend.
RESEND_FROM_EMAIL=Peter from Cobble <hello@yourdomain.com>
# A real, monitored inbox. Replies to the confirmation email land here.
RESEND_REPLY_TO_EMAIL=peter@yourdomain.com
